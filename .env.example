# Example environment variables for AI Box
# Copy this file to ".env" or add these to /etc/environment or your system environment.
# DO NOT commit real API keys to git.

# Replace with your Google API key (Generative AI / Gemini-enabled key)
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# Optional: GitHub token if you want authenticated update checks
# GITHUB_TOKEN=your_github_token_here
